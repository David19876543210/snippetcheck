# Supabase project settings -> API. Use the service role key here (server-side
# only, never exposed to the browser) since report_requests has RLS enabled with
# no public policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key, used to notify NOTIFY_EMAIL on each report request.
RESEND_API_KEY=
NOTIFY_EMAIL=
